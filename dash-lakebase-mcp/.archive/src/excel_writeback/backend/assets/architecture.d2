direction: right

# Styles
style: {
  stroke-width: 2
  fill: "#ffffff"
  border-radius: 8
  font-size: 14
}

# --- Top Level ---
user: User {
  style.stroke: "#1A73E8"
  style.fill: "#E8F0FE"
}

# --- Data Intelligence Platform ---
databricks: Data Intelligence Platform {
  style.stroke: "#B0BEC5"
  style.fill: "#F8F9FA"
  style.stroke-dash: 0

  # Row 1: App + Lakebase + UC
  
  app_range: Databricks App {
    style.stroke: "#FF3621"
    
    range_opt: Range Optimizer {
      style.stroke: "#1A73E8"
      style.fill: "#ffffff"
    }
  }

  lakebase: Lakebase\n(PostgreSQL) {
    style.stroke: "#FF3621"
    style.fill: "#FFF5F5"
  }

  uc: Unity Catalog {
    style.stroke: "#FF3621"
    
    forecast: Forecast Results\n(as Delta) {
      style.stroke: "#1A73E8"
    }
    
    reg_models: Registered\nOptimizer Models {
      style.stroke: "#1A73E8"
    }
  }

  # Row 2: Agent + MCP + Optimizer Model

  agent_box: Agent {
    style.stroke: "#FF3621"
    
    agent: Orchestration\nFramework {
      style.stroke: "#1A73E8"
    }
  }

  app_mcp: Databricks App {
    style.stroke: "#FF3621"
    
    mcp: Custom\nMCP Server {
      style.stroke: "#1A73E8"
      style.fill: "#ffffff"
    }
  }

  opt_model: Optimizer Model {
    style.stroke: "#FF3621"
    style.fill: "#FFF5F5"
  }

  # Row 3: Gateway + Serving

  inference: Inference\ntable {
    style.stroke: "#8B0000"
    style.stroke-width: 2
  }

  gateway: AI Gateway {
    style.stroke: "#FF3621"
    style.fill: "#FFF5F5"
  }

  serving: Model Serving {
    style.stroke: "#FF3621"
    
    llm: LLM {
      style.stroke: "#1A73E8"
      style.fill: "#ffffff"
    }
  }
}

# --- Connections ---

# User -> App
user -> databricks.app_range.range_opt: query / response {
  style.stroke: "#1A73E8"
}

# App -> Agent (bi-directional)
databricks.app_range.range_opt <-> databricks.agent_box.agent: {
  style.stroke: "#FF3621"
}

# App -> Lakebase
databricks.app_range.range_opt -> databricks.lakebase: {
  style.stroke: "#FF3621"
}

# Agent -> MCP
databricks.agent_box.agent -> databricks.app_mcp.mcp: {
  style.stroke: "#FF3621"
}

# Agent -> Gateway
databricks.agent_box.agent -> databricks.gateway: prompt / response {
  style.stroke: "#FF3621"
}

# MCP -> Lakebase (bi-directional)
databricks.app_mcp.mcp <-> databricks.lakebase: {
  style.stroke: "#FF3621"
}

# MCP -> Optimizer Model
databricks.app_mcp.mcp -> databricks.opt_model: {
  style.stroke: "#FF3621"
}

# Lakebase <-> Optimizer Model
databricks.lakebase <-> databricks.opt_model: {
  style.stroke: "#FF3621"
}

# UC Integration
databricks.uc.forecast -> databricks.lakebase: {
  style.stroke: "#FF3621"
}
databricks.uc.reg_models -> databricks.opt_model: {
  style.stroke: "#FF3621"
}

# Gateway & Serving
databricks.gateway <-> databricks.serving.llm: {
  style.stroke: "#FF3621"
}
databricks.gateway -> databricks.inference: {
  style.stroke: "#FF3621"
}

# --- Layout Hints (Grid-like) ---

# Row 1 alignment
databricks.app_range -> databricks.lakebase: {style.opacity: 0}
databricks.lakebase -> databricks.uc: {style.opacity: 0}

# Row 2 alignment
databricks.agent_box -> databricks.app_mcp: {style.opacity: 0}
databricks.app_mcp -> databricks.opt_model: {style.opacity: 0}

# Vertical alignment
databricks.app_range -> databricks.agent_box: {style.opacity: 0}
databricks.agent_box -> databricks.gateway: {style.opacity: 0}
databricks.gateway -> databricks.serving: {style.opacity: 0}

# MCP under Lakebase
databricks.lakebase -> databricks.opt_model: {style.opacity: 0}
